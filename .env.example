# Nur Geheimnisse und Infrastruktur stehen hier – alles andere stellst du im Dashboard ein.

# Solana-RPC. Eigener (Helius, QuickNode, Triton …) dringend empfohlen, der öffentliche ist stark gedrosselt.
RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API=https://lite-api.jup.ag/swap/v1

# Private Key aus Phantom (Base58): Einstellungen -> Konto -> "Privaten Schlüssel anzeigen".
# EMPFEHLUNG: eigenes Phantom-Konto nur für den Bot, kleines Budget. Niemals die Seed Phrase verwenden.
# Leer lassen = nur Simulation möglich.
PRIVATE_KEY=

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
# Optional: Passwort fürs Dashboard (dann http://…/?token=DEINTOKEN öffnen). Pflicht, falls nicht nur lokal erreichbar.
DASHBOARD_TOKEN=

# DATA_SOURCE=mock zeigt erzeugte Demo-Kurse (zum Ausprobieren ohne Internet). Für echten Betrieb weglassen.
# DATA_SOURCE=mock
