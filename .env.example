# --- Verbindung ---
# Eigener RPC empfohlen (z.B. Helius, QuickNode, Triton). Der öffentliche ist stark rate-limitiert.
RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API=https://lite-api.jup.ag/swap/v1

# --- Wallet ---
# Private Key aus Phantom: Einstellungen -> Konto -> "Privaten Schlüssel anzeigen" (Base58).
# EMPFEHLUNG: Lege in Phantom ein NEUES, separates Konto nur für den Bot an und lade dort nur
# so viel drauf, wie du bereit bist zu verlieren. Niemals die Seed Phrase verwenden/teilen.
PRIVATE_KEY=

# --- Sicherheit ---
# true = nur simulieren, es wird NICHTS gesendet. Erst auf false stellen, wenn du die Logs verstanden hast.
DRY_RUN=true

# --- Handel ---
# Paar: Basis-Token (wird gekauft/verkauft) gegen Quote-Token (Stablecoin)
BASE_MINT=So11111111111111111111111111111111111111112
BASE_DECIMALS=9
BASE_SYMBOL=SOL
QUOTE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
QUOTE_DECIMALS=6
QUOTE_SYMBOL=USDC

# Einsatz pro Kauf in Quote-Token (USDC)
TRADE_SIZE_QUOTE=10
# Slippage in Basispunkten (50 = 0,5 %)
SLIPPAGE_BPS=50
# Swap abbrechen, wenn Price Impact höher ist (in %)
MAX_PRICE_IMPACT_PCT=1

# --- Strategie (SMA-Crossover) ---
POLL_INTERVAL_SEC=60
SMA_FAST=5
SMA_SLOW=20

# --- Risiko ---
STOP_LOSS_PCT=5
TAKE_PROFIT_PCT=10
MAX_TRADES_PER_DAY=6
# So viel SOL bleibt immer für Gebühren in der Wallet
MIN_SOL_RESERVE=0.02
