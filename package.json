{
  "name": "phantom-defi-bot",
  "version": "1.0.0",
  "description": "Solana DeFi Trading-Bot (Jupiter) für ein Phantom-Wallet",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "concurrently -k -n bot,web -c magenta,cyan \"tsx watch src/index.ts\" \"vite web\"",
    "build": "tsc --noEmit && tsc -p web --noEmit && vite build web",
    "demo": "DATA_SOURCE=mock tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dav108id/dav108id.git"
  },
